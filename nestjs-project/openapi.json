  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "aB3dE_fG9hK",
            "description": "Public ID (11 chars)"
          },
          "status": {
            "type": "string",
            "example": "uploading"
          },
          "partSizeBytes": {
            "type": "number",
            "example": 67108864
          },
          "partCount": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "id",
          "status",
          "partSizeBytes",
          "partCount"
        ]
      },
      "PartUrlsDto": {
        "type": "object",
        "properties": {}
      },
      "PresignedPartUrlDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "example": "http://localhost:9000/videos/..."
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartUrlDto"
            }
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "parts",
          "expiresAt"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "container": {
            "type": "object",
            "nullable": true,
            "example": "mp4"
          },
          "videoCodec": {
            "type": "object",
            "nullable": true,
            "example": "h264"
          },
          "audioCodec": {
            "type": "object",
            "nullable": true,
            "example": "aac"
          },
          "width": {
            "type": "object",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "object",
            "nullable": true,
            "example": 1080
          },
          "bitrate": {
            "type": "object",
            "nullable": true,
            "example": 4500000
          }
        },
        "required": [
          "container",
          "videoCodec",
          "audioCodec",
          "width",
          "height",
          "bitrate"
        ]
      },
      "VideoDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "aB3dE_fG9hK",
            "description": "Public ID (11 chars)"
          },
          "title": {
            "type": "string",
            "example": "Meu vídeo"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ],
            "example": "ready"
          },
          "sizeBytes": {
            "type": "number",
            "example": 104857600
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4"
          },
          "durationSeconds": {
            "type": "object",
            "nullable": true,
            "example": 5.005
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "thumbnailUrl": {
            "type": "object",
            "nullable": true,
            "example": "http://localhost:9000/thumbnails/2f1c9a6e-....jpg",
            "description": "Stable public URL of the thumbnail"
          },
          "failureReason": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "sizeBytes",
          "contentType",
          "durationSeconds",
          "metadata",
          "thumbnailUrl",
          "failureReason",
          "createdAt"
        ]
      },
      "SignedUrlDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "http://localhost:9000/videos/2f1c9a6e-.../original?X-Amz-...",
            "description": "Short-lived presigned URL served directly by storage"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"9b2cf535f27731c974343645a3985328\""
          },
          "sizeBytes": {
            "type": "number",
            "example": 67108864
          }
        },
        "required": [
          "partNumber",
          "etag",
          "sizeBytes"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "aB3dE_fG9hK"
          },
          "status": {
            "type": "string",
            "example": "processing"
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}